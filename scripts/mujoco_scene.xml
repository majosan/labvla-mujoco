<mujoco model="labvla_scene">
  <!-- Pull in the full Franka Panda model (joints, actuators, meshes, keyframes) -->
  <include file="/home/josan/venv/ai-chem-lab/mujoco_menagerie/franka_emika_panda/panda.xml"/>

  <statistic center="0.1 0.2 0.5" extent="1.8"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="120" elevation="-20"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="512"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge"
      rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3" markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
    <material name="table_mat" rgba="0.78 0.65 0.52 1" reflectance="0.05"/>
  </asset>

  <worldbody>
    <!-- Extra scene lighting -->
    <light name="scene_front" pos="0 -1.5 2" dir="0 1 -1" directional="true" diffuse="0.5 0.5 0.5" specular="0.1 0.1 0.1"/>
    <light name="scene_left"  pos="-1 0.5 2" dir="1 0 -1" directional="true" diffuse="0.3 0.3 0.3" specular="0 0 0"/>

    <!-- Floor well below the robot so objects don't fall forever -->
    <geom name="floor" type="plane" size="0 0 0.05" pos="0 0 -0.82" material="groundplane"/>

    <!--
      Table top surface: the Franka link0 base sits at the world origin (0,0,0).
      The table top is a thin box whose top face is at z=0, so the robot appears
      to stand on the table.  The geom extends from z=-0.02 to z=0.
    -->
    <geom name="table_top" type="box" size="0.6 0.75 0.01"
          pos="0 0.1 -0.01" material="table_mat" contype="1" conaffinity="1"/>
    <!-- Table legs -->
    <geom name="table_leg1" type="box" size="0.025 0.025 0.4" pos=" 0.55  0.8 -0.41" rgba="0.55 0.45 0.35 1"/>
    <geom name="table_leg2" type="box" size="0.025 0.025 0.4" pos="-0.55  0.8 -0.41" rgba="0.55 0.45 0.35 1"/>
    <geom name="table_leg3" type="box" size="0.025 0.025 0.4" pos=" 0.55 -0.6 -0.41" rgba="0.55 0.45 0.35 1"/>
    <geom name="table_leg4" type="box" size="0.025 0.025 0.4" pos="-0.55 -0.6 -0.41" rgba="0.55 0.45 0.35 1"/>

    <!--
      Lab objects on the table (static, no collision, for visual context).
      Beaker: glass-blue cylinder, Test tube: yellow narrow cylinder.
      Both placed in the robot's reachable workspace.
    -->
    <geom name="beaker" type="cylinder" size="0.035 0.055"
          pos="0.20 0.35 0.055" rgba="0.65 0.82 0.95 0.80"
          contype="0" conaffinity="0"/>
    <geom name="test_tube" type="cylinder" size="0.013 0.065"
          pos="-0.12 0.30 0.065" rgba="0.92 0.92 0.38 0.90"
          contype="0" conaffinity="0"/>

    <!--
      Three 224×224 RGB cameras.  Resolution is set at render time; only pos/orientation/fovy
      are recorded here.

      Camera 1 – front-top, looking down at the workspace from the front.
        pos=(0, -1.5, 1.2), pointing toward workspace centre ~(0, 0.2, 0.4).
        xyaxes derived by Gram-Schmidt from world-up and forward vector.

      Camera 2 – side-left, 45-degree angle from the left.
        pos=(-1.2, 0.2, 1.0), pointing toward ~(0, 0.2, 0.4).

      Camera 3 – side-right, mirrored from camera 2.
        pos=(1.2, 0.2, 1.0), pointing toward ~(0, 0.2, 0.4).
    -->
    <camera name="camera_1_rgb"
            pos="0 -1.5 1.2"
            xyaxes="1 0 0  0 0.426 0.905"
            fovy="60"/>
    <camera name="camera_2_rgb"
            pos="-1.2 0.2 1.0"
            xyaxes="0 -1 0  0.447 0 0.894"
            fovy="60"/>
    <camera name="camera_3_rgb"
            pos="1.2 0.2 1.0"
            xyaxes="0 1 0  -0.447 0 0.894"
            fovy="60"/>
  </worldbody>
</mujoco>
