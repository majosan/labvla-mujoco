<mujoco model="labvla_scene">
  <!-- Pull in the full Franka Panda model (joints, actuators, meshes, keyframes) -->
  <include file="/home/josan/ai-chem-lab/mujoco_menagerie/franka_emika_panda/panda.xml"/>

  <!--
    Layout:
      - Franka link0 base stays at world origin (0,0,0) — robot stands on the floor.
      - Floor plane at z=0.
      - Lab table in front of the robot: surface at z=0.76 m (standard height).
        Table center-front at y≈0.65 m, within the arm's horizontal reach.
      - Beaker and test tube sit on the table surface.
      - Cameras re-aimed at the table workspace (~z=0.8 m).
  -->

  <statistic center="0.1 0.4 0.6" extent="2.0"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="120" elevation="-20"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="512"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge"
      rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3" markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
    <material name="table_mat" rgba="0.78 0.65 0.52 1" reflectance="0.05"/>
  </asset>

  <worldbody>
    <light name="scene_front" pos="0.1 -1.0 2.5" dir="0 0.5 -1" directional="true" diffuse="0.55 0.55 0.55" specular="0.1 0.1 0.1"/>
    <light name="scene_left"  pos="-1.5 0.6 2.0" dir="1 0 -1"   directional="true" diffuse="0.30 0.30 0.30" specular="0 0 0"/>

    <!-- Ground — robot base sits on this at z=0 -->
    <geom name="floor" type="plane" size="0 0 0.05" pos="0 0 0" material="groundplane"/>

    <!--
      Lab table: surface at z=0.76 m.
      Positioned in front of the robot (y≈0.65 m) so the arm can reach the objects.
      Table top box: half-size (0.40, 0.30, 0.02) → top face at z=0.76.
    -->
    <geom name="table_top"  type="box" size="0.40 0.30 0.02"
          pos="0.10 0.65 0.70" material="table_mat" contype="1" conaffinity="1"/>
    <!-- Legs: half-height 0.34, center at z=0.34 → top at z=0.68, bottom at z=0 -->
    <geom name="table_leg1" type="box" size="0.025 0.025 0.34" pos=" 0.45  0.90 0.34" rgba="0.55 0.45 0.35 1"/>
    <geom name="table_leg2" type="box" size="0.025 0.025 0.34" pos="-0.25  0.90 0.34" rgba="0.55 0.45 0.35 1"/>
    <geom name="table_leg3" type="box" size="0.025 0.025 0.34" pos=" 0.45  0.40 0.34" rgba="0.55 0.45 0.35 1"/>
    <geom name="table_leg4" type="box" size="0.025 0.025 0.34" pos="-0.25  0.40 0.34" rgba="0.55 0.45 0.35 1"/>

    <!--
      Lab objects on the table surface (z=0.72 + half-height).
      Beaker  (r=0.035, h_half=0.055) → center z = 0.72+0.055 = 0.775
      TestTube(r=0.013, h_half=0.065) → center z = 0.72+0.065 = 0.785
    -->
    <geom name="beaker" type="cylinder" size="0.035 0.055"
          pos="0.20 0.65 0.775" rgba="0.65 0.82 0.95 0.80"
          contype="0" conaffinity="0"/>
    <geom name="test_tube" type="cylinder" size="0.013 0.065"
          pos="-0.05 0.60 0.785" rgba="0.92 0.92 0.38 0.90"
          contype="0" conaffinity="0"/>

    <!--
      Cameras re-aimed at the table workspace centre ~(0.1, 0.65, 0.80).

      Camera 1 – front-top: pos=(0.1, -1.0, 1.8), looking down at table.
        forward=(0, 1.65, -1.0), xyaxes Gram-Schmidt from world-up.

      Camera 2 – side-left: pos=(-1.2, 0.65, 1.5), looking right and slightly down.

      Camera 3 – side-right: pos=(1.4, 0.65, 1.5), mirrored.
    -->
    <camera name="camera_1_rgb"
            pos="0.1 -1.0 1.8"
            xyaxes="1 0 0  0 0.530 0.848"
            fovy="60"/>
    <camera name="camera_2_rgb"
            pos="-1.2 0.65 1.5"
            xyaxes="0 -1 0  0.474 0 0.880"
            fovy="60"/>
    <camera name="camera_3_rgb"
            pos="1.4 0.65 1.5"
            xyaxes="0 1 0  -0.474 0 0.880"
            fovy="60"/>
  </worldbody>
</mujoco>
